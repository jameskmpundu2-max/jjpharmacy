# Neon pooled PostgreSQL connection string from the Neon Console. Keep it private.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Use the same DATABASE_URL at every branch and a unique BRANCH_ID per branch.
BRANCH_ID=main
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Set true only when deployed behind HTTPS (e.g. Vercel/Render/Fly proxy).
COOKIE_SECURE=false

# Administrator account for this branch's schema; synchronized when the app starts.
ADMIN_NAME=Pharmacy Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
PHARMACY_NAME=J&J Pharmacy
PHARMACY_ADDRESS=Lusaka, Zambia
PHARMACY_PHONE=+260XXXXXXXXX
CURRENCY=ZMW

# Cross-branch read-only stock lookup. Use the same random token on every branch.
BRANCH_NETWORK_TOKEN=generate-a-different-random-token-at-least-32-characters
# JSON list of other branch sites, configured separately for each branch deployment.
BRANCH_DIRECTORY=[]
